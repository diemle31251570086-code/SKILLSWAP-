rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'diemle.31251570086@st.ueh.edu.vn' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']))
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'diemle.31251570086@st.ueh.edu.vn' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    // 0. Connection Test
    match /test/connection {
      allow read: if true;
    }

    // 1. Users
    match /users/{userId} {
      allow read: if isSignedIn();
      // Registration: cannot self-assign elevated role unless designated superadmin email
      allow create: if isOwner(userId) && (
        request.resource.data.role == 'user' ||
        (request.resource.data.role == 'superadmin' && request.auth.token.email == 'diemle.31251570086@st.ueh.edu.vn')
      );
      // User update: cannot escalate role
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Admins reference collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // 3. Skills
    match /skills/{skillId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.createdBy || isAdmin());
    }

    // 4. Skill Categories
    match /skillCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Connections (1-on-1 Matching)
    match /connections/{connectionId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId || isAdmin());
      allow create: if isSignedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId || isAdmin());
      allow delete: if isAdmin();
    }

    // 6. Groups
    match /groups/{groupId} {
      allow read: if isSignedIn() || resource.data.isPublic == true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentMembersCount', 'updatedAt', 'status'])
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // 7. Group Members
    match /groupMembers/{memberDocId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() || 
        request.auth.uid == get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId
      );
    }

    // 8. Group Join Requests
    match /groupJoinRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // 9. Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();
    }

    // 10. Messages
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isAdmin());
    }

    // 11. Schedules
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.createdBy || isAdmin());
    }

    // 12. Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    // 13. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                    request.resource.data.reviewerId == request.auth.uid && 
                    request.resource.data.targetId != request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // 14. Reports
    match /reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 15. CMS
    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. Admin Logs (Immutable)
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 17. System Settings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
